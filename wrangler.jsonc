{
  "$schema": "node_modules/wrangler/config-schema.json",
  // このファイルはローカル開発 (wrangler dev) とテスト (vitest) が読むダミー値の設定で、デプロイには使わない。
  // アカウント固有の値 (D1 の id・Access のチーム / AUD) はここに書かない。
  // デプロイ用の設定は M06 で、mise.local.toml の [env] から wrangler.deploy.jsonc (gitignore 済み) に生成する。
  "name": "board",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  // compatibility_date は、固定した workerd が対応する最新日。
  // nodejs_compat は必要になったときだけ足す。
  "compatibility_flags": [],
  // カスタムドメインだけで公開する。Access を迂回できる workers.dev の経路は作らない。
  "workers_dev": false,
  "observability": { "enabled": true },
  "d1_databases": [
    // キャッシュ用 (M03 で使う)。M01 では設定チェックの対象にするだけ。ダミーの database_id。
    {
      "binding": "DB",
      "database_name": "board",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    // いずれもダミー。Cloudflare Access (self-hosted / MCP server application) のチーム名と AUD タグ。
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<access-application-aud>",
    // BOARD API のベース URL。
    "BOARD_BASE_URL": "https://api.the-board.jp"
  }
  // secrets (デプロイ先で wrangler secret put / --secrets-file。ローカルは .dev.vars):
  //   BOARD_API_KEY   BOARD の API キー (x-api-key ヘッダー)。全利用者で共有する
  //   BOARD_API_TOKEN BOARD の API トークン (Authorization: Bearer)。全利用者で共有する
}
