# =============================================================
# 共通（必須）
# =============================================================
ROLE_ARN=arn:aws:iam::123456789012:role/board-lambda-role

# BOARD API 認証情報（Lambda 環境では config.toml ではなく env で渡す）
BOARD_API_KEY=
BOARD_API_TOKEN=

# Optional: mise.toml [env] のデフォルトを上書き
# AWS_REGION=ap-northeast-1
# BOARD_VERSION=0.9.0
# LAMBDA_ARCH=arm64

# =============================================================
# OIDC（必須）
# =============================================================
# 暫定値: deploy 後に Function URL が確定したら書き換えて再デプロイ
BOARD_MCP_EXTERNAL_URL=https://xxx.lambda-url.ap-northeast-1.on.aws
BOARD_MCP_OIDC_ISSUER=https://your-idp.example.com
BOARD_MCP_OIDC_CLIENT_ID=
BOARD_MCP_OIDC_CLIENT_SECRET=
# 32 bytes hex: openssl rand -hex 32
BOARD_MCP_COOKIE_SECRET=

# 任意: アクセス制限（カンマ区切り、未設定=全員許可）
# BOARD_MCP_ALLOWED_DOMAINS=example.com,example.co.jp
# BOARD_MCP_ALLOWED_EMAILS=user1@example.com

# =============================================================
# Lambda 必須: idproxy DynamoDB Store + ECDSA 署名鍵
#   ランダム署名鍵は Lambda コンテナ間で共有できないため、
#   PEM 形式の ECDSA P-256 鍵を固定値で投入する必要がある:
#     openssl ecparam -name prime256v1 -genkey -noout -out signing.pem
#     # 改行を \n にエスケープして環境変数に埋め込む
# =============================================================
BOARD_MCP_SIGNING_KEY=
BOARD_MCP_IDPROXY_STORE_DYNAMODB_TABLE=board-mcp-idproxy
BOARD_MCP_IDPROXY_STORE_DYNAMODB_REGION=ap-northeast-1
